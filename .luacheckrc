std = "lua51"
max_line_length = 120
exclude_files = { ".luarocks", "lua_modules" }

-- Globals the add-on owns (SavedVariables, slash command registration).
globals = {
    "AtlasiumDB",
    "SLASH_ATLASIUM1",
    "SlashCmdList",
}

-- WoW 3.3.5a API in use. Add entries as you use more of the API.
read_globals = {
    "ClearOverrideBindings",
